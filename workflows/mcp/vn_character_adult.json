{
  "1": {
    "inputs": {
      "ckpt_name": "flux1-dev-fp8.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load Checkpoint"}
  },
  "2": {
    "inputs": {
      "lora_name": "PARAM_STR_LORA_NAME",
      "strength_model": "PARAM_FLOAT_STYLE_STRENGTH",
      "strength_clip": 0,
      "model": ["1", 0],
      "clip": ["1", 1]
    },
    "class_type": "LoraLoader",
    "_meta": {"title": "Style LoRA (the game's look)"}
  },
  "3": {
    "inputs": {
      "lora_name": "PARAM_STR_ADAPTER_NAME",
      "strength_model": "PARAM_FLOAT_ADAPTER_STRENGTH",
      "strength_clip": 0,
      "model": ["2", 0],
      "clip": ["2", 1]
    },
    "class_type": "LoraLoader",
    "_meta": {"title": "Adult adapter -- stacked ON the style, 0.6-0.8"}
  },
  "4": {
    "inputs": {
      "text": "PARAM_PROMPT",
      "clip": ["3", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"}
  },
  "5": {
    "inputs": {
      "conditioning": ["4", 0],
      "guidance": 3.5
    },
    "class_type": "FluxGuidance",
    "_meta": {"title": "Flux Guidance (house constant 3.5)"}
  },
  "6": {
    "inputs": {
      "text": "PARAM_NEGATIVE_PROMPT",
      "clip": ["3", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"}
  },
  "7": {
    "inputs": {
      "width": "PARAM_INT_WIDTH",
      "height": "PARAM_INT_HEIGHT",
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Empty Latent -- ALWAYS pass; defaults to 512x512"}
  },
  "8": {
    "inputs": {
      "seed": "PARAM_INT_SEED",
      "steps": "PARAM_INT_STEPS",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["3", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "KSampler (cfg 1.0 -- Flux is guidance-distilled)"}
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },
  "10": {
    "inputs": {
      "image": ["9", 0],
      "torchscript_jit": "default"
    },
    "class_type": "InspyrenetRembg",
    "_meta": {"title": "Cut the figure out -- alpha, same as the clothed variant"}
  },
  "11": {
    "inputs": {
      "filename_prefix": "vn_adult",
      "images": ["10", 0]
    },
    "class_type": "SaveImage",
    "_meta": {"title": "Save RGBA PNG"}
  }
}
