{
  "name": "Generate Image with Two LoRAs",
  "description": "Text-to-image with Flux 1 Dev and TWO stacked LoRA adapters (chained loaders) — e.g. a pose/multiview LoRA (mv_ortho) plus a style LoRA (grimforge_style) so pose AND look are baked into a single generation. Each LoRA has its own name + strength.",
  "requirements": {
    "nodes": ["CheckpointLoaderSimple", "LoraLoader", "EmptySD3LatentImage", "CLIPTextEncode", "KSampler", "VAEDecode", "SaveImage"],
    "models": {
      "checkpoint": "flux1-dev-fp8.safetensors",
      "lora": "two user-specified (PARAM_STR_LORA_NAME, PARAM_STR_LORA2_NAME)"
    },
    "minimum_vram_gb": 12
  },
  "parameters": {
    "prompt": {"type": "string", "required": true, "description": "Text description of desired image"},
    "negative_prompt": {"type": "string", "required": false, "description": "Things to avoid"},
    "lora_name": {"type": "string", "required": true, "description": "Filename of the FIRST LoRA (applied first; e.g. pose/multiview like style\\mv_ortho.safetensors)"},
    "lora_strength": {"type": "float", "required": false, "description": "First LoRA influence (model + CLIP)"},
    "lora2_name": {"type": "string", "required": true, "description": "Filename of the SECOND LoRA (chained after the first; e.g. style like style\\grimforge_style.safetensors)"},
    "lora2_strength": {"type": "float", "required": false, "description": "Second LoRA influence (model + CLIP)"},
    "width": {"type": "int", "required": false, "description": "Image width in pixels"},
    "height": {"type": "int", "required": false, "description": "Image height in pixels"},
    "seed": {"type": "int", "required": false, "description": "Random seed"},
    "steps": {"type": "int", "required": false, "description": "Sampling steps"},
    "cfg": {"type": "float", "required": false, "description": "CFG scale"},
    "sampler_name": {"type": "string", "required": false, "description": "Sampler algorithm"},
    "scheduler": {"type": "string", "required": false, "description": "Noise scheduler"},
    "denoise": {"type": "float", "required": false, "description": "Denoising strength"}
  },
  "output": {
    "type": "image",
    "format": "png",
    "node": "SaveImage"
  },
  "category": "generation",
  "tags": ["lora", "multi-lora", "flux", "text-to-image", "style", "pose", "mv_ortho"]
}
